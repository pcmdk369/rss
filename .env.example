# Android runtime LLM credentials are entered in SuperiOA > Settings > LLM engines.
# They are stored in Android Keystore-backed encrypted preferences on the device.
# Do not commit real credentials or place API keys in the APK.
# This file is a naming template only; Gradle does not inject these values into BuildConfig.

LLM_ENGINE_1_API_KEY=
LLM_ENGINE_1_BASE_URL=
LLM_ENGINE_1_MODEL_ID=
